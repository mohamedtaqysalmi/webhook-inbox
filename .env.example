# Copy to .env and adjust. The app reads real environment variables;
# load this file with your process manager or `set -a; . ./.env; set +a`.

# SQLite file path. Created on first start.
WEBHOOK_INBOX_DB_PATH=webhook_inbox.db

# Largest request body accepted, in bytes (default 1 MiB). Larger requests get a 413.
WEBHOOK_INBOX_MAX_BODY_BYTES=1048576

# Most header bytes stored per request (names plus values). Extra headers are dropped
# and the stored request is flagged headers_truncated.
WEBHOOK_INBOX_MAX_HEADER_BYTES=16384

# Public base URL used to build endpoint URLs returned by POST /api/endpoints.
WEBHOOK_INBOX_BASE_URL=http://localhost:8000

# Max create/receive requests per client IP per rolling minute. 0 disables the limiter.
WEBHOOK_INBOX_RATE_LIMIT_PER_MINUTE=120

# Delete stored requests older than this many days. 0 keeps everything forever.
WEBHOOK_INBOX_RETENTION_DAYS=7

# Outbound HTTP timeout used when replaying a stored request.
WEBHOOK_INBOX_REPLAY_TIMEOUT_SECONDS=10

# Allow replay to private/loopback addresses. Keep false outside local demos.
WEBHOOK_INBOX_ALLOW_PRIVATE_REPLAY_TARGETS=false
